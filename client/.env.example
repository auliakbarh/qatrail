# Client env — ALL values are baked into the bundle at build time.
# Never put a secret here. Copy to .env (dev) or .env.production (build), then rebuild.

# Public GraphQL endpoint. Defaults to http://localhost:4000/graphql when unset.
# VITE_API_URL="https://qa.example.com/graphql"

# Microsoft Entra SSO. Must match MS_TENANT_ID / MS_CLIENT_ID in server/.env, and
# the server needs MS_SSO_ENABLED=true or the button stays disabled.
# Not secrets — a SPA uses PKCE, not a client secret.
# Register the SPA redirect URI as <origin>/login, e.g.
#   http://localhost:5173/login   (dev)
#   https://qa.example.com/login  (prod)
# VITE_MS_TENANT_ID=""
# VITE_MS_CLIENT_ID=""
