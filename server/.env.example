# Server config. Copy to .env and adjust.
DATABASE_URL="postgresql://qar:qar_password@localhost:5434/qa_reporting?schema=public"
JWT_SECRET="dev-insecure-secret"
PORT=4000
NODE_ENV=development
# CORS_ORIGINS="http://localhost:5173"   # required in production
FRONTEND_BASE_URL="http://localhost:5173"

# Super admin (seeded). Leave password blank to auto-generate one (logged once).
SUPER_ADMIN_EMAIL="it@hpam.co.id"
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_PASSWORD=""

# Encrypts test-account passwords at rest (falls back to JWT_SECRET in dev;
# REQUIRED and must differ from JWT_SECRET in production).
# SECRET_ENC_KEY=""

# Optional: enable cross-instance pubsub + login rate-limit for multi-instance
# deploys. Unset = single-process in-memory (fine for one instance).
# REDIS_URL="redis://localhost:6379"

# Maintenance override (wins over admin toggle).
# MAINTENANCE=false

# JIRA (optional — issues work without it).
# JIRA_BASE_URL=""
# JIRA_EMAIL=""
# JIRA_API_TOKEN=""

# Forgot-password email via Acacia. When unset, the reset link is logged (dev).
# ACACIA_URL=""
# ACACIA_API_KEY=""

# Discord webhook is configured in-app (Settings → Discord), stored in DB.

# Microsoft Entra SSO (OIDC). Single-tenant SPA registration; the client needs the
# same two ids as VITE_MS_TENANT_ID / VITE_MS_CLIENT_ID. Only pre-created, active
# users can sign in — the email must already exist in the users table.
# MS_SSO_ENABLED=false
# MS_TENANT_ID=""
# MS_CLIENT_ID=""

# SharePoint attachment upload — prepared, not implemented (attachments are URLs today).
# SHAREPOINT_ENABLED=false

# LOG_LEVEL=info
