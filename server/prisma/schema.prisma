// QA Reporting — Prisma schema. See docs/DATABASE.md for rationale.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  QA_LEAD
  QA
  ENGINEER
  VIEWER
}

// Review state of a test case. A case only counts as testable content once it is
// APPROVED (see approval.ts for who may approve what).
enum TestCaseApproval {
  PENDING
  APPROVED
  REJECTED
}

enum AuthProvider {
  PASSWORD
  SSO
  BOTH
}

enum FindingType {
  DEFECT
  BUG
}

enum Platform {
  ANDROID
  IOS
  WEB
}

enum Environment {
  STAGING
  PRODUCTION
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum WorkStatus {
  OPEN
  IN_PROGRESS
  NEED_REVIEW
  IN_REVIEW
  CLOSED
  REOPENED
  HOLD
}

enum ReviewState {
  PENDING
  ACCEPTED
  NEED_CLARIFY
  REJECTED
}

enum AppTestStatus {
  OPEN
  ASSIGNED
  IN_TESTING
  PASSED
  CLOSED
}

enum CommentTarget {
  ISSUE
  APP_TEST
  USER_TEST
  SESSION_TEST
  TEST_CASE
}

// A change to existing content that needs approval before it happens. The
// content keeps working until the decision lands — a request must not make
// anything disappear by itself.
enum ApprovalRequestKind {
  MOVE
  COPY
  DELETE
  DEACTIVATE
  ACTIVATE
}

// What a request is about. Polymorphic by plain id, same as Comment/Watch.
enum ApprovalTarget {
  PROJECT
  FEATURE
  TEST_CASE
  APP_TEST
}

// What happens to an app test's assignments when it moves project.
enum MoveAssignmentMode {
  DROP
  CLONE
}

// Kind of testing session. OTHER carries a free-text label in kindOther.
enum SessionKind {
  SIT
  UAT
  OTHER
}

enum TestCaseKind {
  POSITIVE
  NEGATIVE
}

enum TestResult {
  PASS
  FAIL
  // Could not be run: a blocker stopped the test before a verdict existed.
  // Never counts as passed, and never opens an issue on its own.
  BLOCKED
}

enum AttachKind {
  IMAGE
  VIDEO
  MARKDOWN
  JSON
  DOC
  XLS
  CSV
  PDF
  OTHER
}

model User {
  id                 String       @id @default(cuid())
  email              String       @unique
  name               String
  role               Role
  passwordHash       String?
  authProvider       AuthProvider @default(PASSWORD)
  mustChangePassword Boolean      @default(true)
  active             Boolean      @default(true)
  sessionId          String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  projects        Project[]  @relation("projectOwner")
  testCases       TestCase[] @relation("testCaseAuthor")
  testCasesReviewed TestCase[] @relation("testCaseReviewer")

  approvalRequests         ApprovalRequest[] @relation("approvalRequester")
  approvalRequestsReviewed ApprovalRequest[] @relation("approvalReviewer")
  recordTests    RecordTest[]    @relation("testExecutor")
  reportedIssues Issue[]         @relation("reporter")
  assignedIssues Issue[]         @relation("assignee")
  postmortems    Postmortem[]    @relation("postmortemAuthor")
  statusEvents   StatusEvent[]
  notifications  Notification[]
  passwordResets PasswordReset[]
  comments       Comment[]

  appTests             AppTest[]      @relation("appTestCreator")
  appTestBuilds        AppTestBuild[] @relation("appTestBuildCreator")
  appTestCasesAssigned AppTestCase[]  @relation("appTestCaseAssigner")
  userTests            UserTest[]     @relation("userTestCreator")
  watches              Watch[]

  sessionTests             SessionTest[]     @relation("sessionTestCreator")
  sessionTestCasesAssigned SessionTestCase[] @relation("sessionTestCaseAssigner")

  publicApiClients PublicApiClient[] @relation("publicApiClientCreator")
}

model Project {
  id             String   @id @default(cuid())
  number         Int      @unique @default(autoincrement()) // human key: PRJ-<number>
  name           String
  description    String?
  squad          String?
  minPassPercent Int      @default(0)
  createdById    String
  createdBy      User     @relation("projectOwner", fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // Retired project: everything under it stops counting as live content without
  // a single test case row being touched, so activating it restores the exact
  // state it had. Flipping this needs approval.
  active         Boolean  @default(true)

  features     Feature[]
  appTests     AppTest[]
  userTests    UserTest[]
  sessionTests SessionTest[]

  @@index([name])
}

model Feature {
  id             String   @id @default(cuid())
  number         Int      @unique @default(autoincrement()) // human key: FEAT-<number>
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  minPassPercent Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // Same as Project.active, one level down.
  active         Boolean  @default(true)

  testCases TestCase[]

  @@index([projectId])
}

model TestCase {
  id           String        @id @default(cuid())
  number       Int           @unique @default(autoincrement()) // human key: TC-<number>
  featureId    String
  feature      Feature       @relation(fields: [featureId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  precondition String?
  note         String?
  kind         TestCaseKind?
  createdById  String
  createdBy    User          @relation("testCaseAuthor", fields: [createdById], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Approval gate. Defaults to APPROVED so rows that predate the feature stay
  // visible without a backfill — the create paths write PENDING explicitly.
  // reviewedAt/reviewedById carry the latest decision (approve OR reject); the
  // full history is in AuditLog. Null on legacy rows: that review never happened.
  approval     TestCaseApproval @default(APPROVED)
  // First time this case ever went live. Never cleared, so a PENDING case with a
  // value set is a re-review of an edit, and one without is brand new — the
  // reviewer can tell the two apart.
  firstApprovedAt DateTime?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?            @relation("testCaseReviewer", fields: [reviewedById], references: [id])
  rejectReason String?
  // Retired case: keeps its history but leaves the catalogue — no coverage, no
  // new assignment, no new run. Flipping this needs approval too.
  active       Boolean          @default(true)

  steps            TestCaseStep[]
  attachments      TestCaseAttachment[]
  records          RecordTest[]
  issues           Issue[]
  appTestCases     AppTestCase[]
  sessionTestCases SessionTestCase[]

  @@index([featureId])
  @@index([approval])
}

// A pending move/copy/delete/(de)activate on a project, feature or test case.
// Only one may be open per target (enforced in the resolver). Approving runs the
// action; rejecting drops it. Reuses TestCaseApproval for the state — same three
// outcomes. The target is a plain id (no FK, like Comment/Watch), so a resolver
// that deletes a target cleans up its requests.
model ApprovalRequest {
  id              String              @id @default(cuid())
  target          ApprovalTarget
  targetId        String
  kind            ApprovalRequestKind
  targetFeatureId String? // MOVE / COPY destination for a test case
  targetProjectId String? // MOVE / COPY destination for a feature or app test
  targetName      String? // COPY name override
  assignmentMode  MoveAssignmentMode? // app test move: what happens to its assignments
  // Project the target sat in when the request was made. Denormalised so scoped
  // analytics can count approvals without resolving a polymorphic id per row.
  projectId       String?
  // "<target>:<targetId>" while this request is open, null once it is decided.
  // Postgres ignores nulls in a unique index, so this is a partial unique on the
  // pending rows — the DB, not just the resolver, enforces one open request per
  // target. Prisma has no partial-unique syntax and a hand-written index would
  // be dropped by the next `db push`; a nullable column survives it.
  openKey         String?             @unique
  state           TestCaseApproval    @default(PENDING)
  requestedById   String
  requestedBy     User                @relation("approvalRequester", fields: [requestedById], references: [id])
  requestedAt     DateTime            @default(now())
  reviewedById    String?
  reviewedBy      User?               @relation("approvalReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectReason    String?

  @@index([target, targetId])
  @@index([state])
}

model TestCaseStep {
  id             String   @id @default(cuid())
  testCaseId     String
  testCase       TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  order          Int
  step           String
  expectedResult String?

  @@index([testCaseId])
}

model TestCaseAttachment {
  id         String     @id @default(cuid())
  testCaseId String
  testCase   TestCase   @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  order      Int
  url        String
  kind       AttachKind
  label      String?

  @@index([testCaseId])
}

model RecordTest {
  id            String       @id @default(cuid())
  number        Int          @unique @default(autoincrement()) // human key: REC-<number>
  testCaseId    String
  testCase      TestCase     @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  executedById  String
  executedBy    User         @relation("testExecutor", fields: [executedById], references: [id])
  executedAt    DateTime
  note          String?
  result        TestResult
  // Set when this record is a retest of a previously-failed issue (plain ref,
  // no FK) — marks it as verification of that issue's fix.
  retestIssueId String?
  // Set when this run was executed as part of an app test.
  appTestId     String?
  appTest       AppTest?     @relation(fields: [appTestId], references: [id], onDelete: SetNull)
  // Set when this run was executed as part of a testing session (SIT/UAT). A run
  // belongs to one scope only — session runs never count toward app test coverage.
  sessionTestId String?
  sessionTest   SessionTest? @relation(fields: [sessionTestId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  attachments RecordTestAttachment[]
  issue       Issue?

  @@index([testCaseId])
  @@index([result])
  @@index([appTestId])
  @@index([sessionTestId])
}

model RecordTestAttachment {
  id           String     @id @default(cuid())
  recordTestId String
  recordTest   RecordTest @relation(fields: [recordTestId], references: [id], onDelete: Cascade)
  url          String
  kind         AttachKind
  label        String?

  @@index([recordTestId])
}

model Issue {
  id           String      @id @default(cuid())
  number       Int         @unique @default(autoincrement()) // human key: ISSUE-<number>
  testCaseId   String
  testCase     TestCase    @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  recordTestId String?     @unique
  recordTest   RecordTest? @relation(fields: [recordTestId], references: [id], onDelete: SetNull)

  type           FindingType
  title          String
  description    String
  environment    Environment
  platform       Platform
  appVersion     String?
  backendVersion String?
  testAccount    String
  testPassword   String?
  testedAt       DateTime
  preconditions  String?
  steps          String
  actualResult   String
  expectedResult String
  priority       Priority
  note           String?

  // QA-set: this really happened in production (SLA applies). A PRODUCTION
  // environment alone is not enough — testing findings on prod get no SLA.
  // Always false for issues found on an app test.
  isProductionIssue Boolean @default(false)

  status   WorkStatus  @default(OPEN)
  review   ReviewState @default(PENDING)
  archived Boolean     @default(false)

  reporterId String
  reporter   User   @relation("reporter", fields: [reporterId], references: [id])
  assigneeId String
  assignee   User   @relation("assignee", fields: [assigneeId], references: [id])

  // Set when this issue was found while testing an app test.
  appTestId     String?
  appTest       AppTest?     @relation(fields: [appTestId], references: [id], onDelete: SetNull)
  // Set when this issue was found during a testing session (SIT/UAT). Like an
  // app-test finding, it can never be flagged as a production issue (sla.ts).
  sessionTestId String?
  sessionTest   SessionTest? @relation(fields: [sessionTestId], references: [id], onDelete: SetNull)

  recreatedFromId String?

  jiraKey       String?
  jiraCommentId String?

  respondedAt          DateTime?
  resolvedAt           DateTime?
  closedAt             DateTime?
  slaRespondNotifiedAt DateTime?
  slaResolveNotifiedAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  attachments IssueAttachment[]
  history     StatusEvent[]
  postmortem  Postmortem?

  @@index([testCaseId])
  @@index([status])
  @@index([assigneeId])
  @@index([reporterId])
  @@index([archived])
  @@index([appTestId])
  @@index([sessionTestId])
}

model IssueAttachment {
  id      String     @id @default(cuid())
  issueId String
  issue   Issue      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  order   Int
  url     String
  kind    AttachKind
  label   String?

  @@index([issueId])
}

// Generic comment on any commentable entity (issue or app test). targetId is a
// plain ref (no FK) so one model serves both; rows are cleaned by the resolver
// when a target is deleted.
// A user watching an issue or app test to receive activity notifications.
model Watch {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  target    CommentTarget
  targetId  String
  createdAt DateTime      @default(now())

  @@unique([userId, target, targetId])
  @@index([target, targetId])
}

model Comment {
  id        String        @id @default(cuid())
  target    CommentTarget
  targetId  String
  byId      String
  by        User          @relation(fields: [byId], references: [id])
  body      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([target, targetId])
}

// An app build an engineer submits for QA to test. Lives under a Project.
model AppTest {
  id             String        @id @default(cuid())
  number         Int           @unique @default(autoincrement()) // human key: APP-<number>
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User          @relation("appTestCreator", fields: [createdById], references: [id])
  environment    Environment
  platform       Platform
  appVersion     String?
  backendVersion String?
  downloadLink   String
  note           String?
  jiraTickets    String[]
  // Ticket key -> the comment we posted there, so a re-post edits instead of
  // stacking duplicates. A plain map because the ticket list is editable and a
  // parallel array would drift out of step with it.
  jiraCommentIds Json?
  status         AppTestStatus @default(OPEN)
  passedAt       DateTime?
  closedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  assigned    AppTestCase[]
  records     RecordTest[]
  issues      Issue[]
  builds      AppTestBuild[]
  // Sessions that reference this app test as one of their tested apps.
  sessionApps SessionTestApp[]

  @@index([projectId])
  @@index([status])
}

// A testing session QA runs on a date: SIT, UAT or something else. It collects
// the test cases exercised, the apps under test, and closes with a summary —
// the unit a sign-off report is produced from. Status is derived at query time
// (see deriveSessionStatus), never stored.
model SessionTest {
  id             String      @id @default(cuid())
  number         Int         @unique @default(autoincrement()) // human key: ST-<number>
  projectId      String
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User        @relation("sessionTestCreator", fields: [createdById], references: [id])
  testedAt       DateTime
  kind           SessionKind
  kindOther      String? // required when kind = OTHER
  stakeholders   String[]
  minPassPercent Int         @default(0) // agreed go/no-go threshold, 0..100
  jiraTickets    String[]
  jiraCommentIds Json? // ticket key -> our comment id, same as AppTest
  note           String?
  summary        String? // filled when QA closes the session
  closedAt       DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  apps    SessionTestApp[]
  cases   SessionTestCase[]
  records RecordTest[]
  issues  Issue[]

  @@index([projectId])
  @@index([kind])
}

// One app under test in a session. Either a reference to an engineer-submitted
// app test or a manually typed entry. Versions/environment are SNAPSHOT here:
// AppTest always mirrors its newest build, so reading through would silently
// rewrite a signed-off report when a later build lands.
model SessionTestApp {
  id            String       @id @default(cuid())
  sessionTestId String
  sessionTest   SessionTest  @relation(fields: [sessionTestId], references: [id], onDelete: Cascade)
  appTestId     String?
  appTest       AppTest?     @relation(fields: [appTestId], references: [id], onDelete: SetNull)
  name          String
  versionFe     String?
  versionBe     String?
  environment   Environment?
  platform      Platform?
  note          String?
  createdAt     DateTime     @default(now())

  cases SessionTestCase[]

  @@index([sessionTestId])
}

// A test case pulled into a session, optionally related to the session's apps
// (implicit m-n — Prisma owns the join table, no model of our own).
model SessionTestCase {
  id            String      @id @default(cuid())
  sessionTestId String
  sessionTest   SessionTest @relation(fields: [sessionTestId], references: [id], onDelete: Cascade)
  testCaseId    String
  testCase      TestCase    @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  assignedById  String
  assignedBy    User        @relation("sessionTestCaseAssigner", fields: [assignedById], references: [id])
  assignedAt    DateTime    @default(now())

  apps SessionTestApp[]

  @@unique([sessionTestId, testCaseId])
  @@index([sessionTestId])
  @@index([testCaseId])
}

// One build submitted for an app test. The app test's own downloadLink/versions
// always mirror the newest build; this table is the history (who shipped what,
// when, why). Test-case assignments and records live on the app test, so a new
// build continues the same testing round instead of starting a new one.
model AppTestBuild {
  id             String   @id @default(cuid())
  appTestId      String
  appTest        AppTest  @relation(fields: [appTestId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User     @relation("appTestBuildCreator", fields: [createdById], references: [id])
  downloadLink   String
  appVersion     String?
  backendVersion String?
  note           String?
  createdAt      DateTime @default(now())

  @@index([appTestId])
}

// A reusable test credential (account/password) for a project+environment.
model UserTest {
  id          String      @id @default(cuid())
  number      Int         @unique @default(autoincrement()) // human key: UT-<number>
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User        @relation("userTestCreator", fields: [createdById], references: [id])
  account     String
  password    String? // encrypted at rest (crypto.ts)
  environment Environment
  note        String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([projectId])
}

// Assignment of an existing test case to an app test (QA-driven).
model AppTestCase {
  id           String   @id @default(cuid())
  appTestId    String
  appTest      AppTest  @relation(fields: [appTestId], references: [id], onDelete: Cascade)
  testCaseId   String
  testCase     TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy   User     @relation("appTestCaseAssigner", fields: [assignedById], references: [id])
  assignedAt   DateTime @default(now())

  @@unique([appTestId, testCaseId])
  @@index([appTestId])
  @@index([testCaseId])
}

model Postmortem {
  id           String   @id @default(cuid())
  issueId      String   @unique
  issue        Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  rootCause    String
  resolution   String
  impact       String?
  prevention   String?
  resolvedById String
  resolvedBy   User     @relation("postmortemAuthor", fields: [resolvedById], references: [id])
  resolvedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StatusEvent {
  id      String   @id @default(cuid())
  issueId String
  issue   Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  kind    String
  fromVal String?
  toVal   String?
  byId    String
  by      User     @relation(fields: [byId], references: [id])
  note    String?
  at      DateTime @default(now())

  @@index([issueId])
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          String
  message       String
  issueId       String?
  appTestId     String?
  userTestId    String?
  sessionTestId String?
  testCaseId    String?
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId, read])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Setting {
  id                 String   @id @default("singleton")
  maintenanceMode    Boolean  @default(false)
  maintenanceMessage String?
  discordWebhookUrl  String?
  discordEnabled     Boolean  @default(false)
  // Auto-approval for test case review, in hours. null = never (a human must
  // decide); 0 = approved on the spot; N = approved once it has waited N hours
  // without a decision (the scheduler sweeps). New cases and changes
  // (edit/move/copy/delete/activate/deactivate) are configured separately.
  autoApproveNewHours    Int?
  autoApproveChangeHours Int?
  // Microsoft SSO for an email with no User row: false = refuse (an admin must
  // create the account first), true = create it as VIEWER (read-only) on first
  // sign-in. Off by default — auto-provision hands an account to anyone in the
  // tenant, which is a policy call, not a default.
  ssoAutoProvision   Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

model SlaTarget {
  priority    Priority @id
  respondMins Int?
  resolveMins Int
  updatedAt   DateTime @updatedAt
}

// Server-to-server consumer of the read-only public API (`docs/API_PUBLIC.md`).
// Not a login: it never maps to a User session, and the key can only read.
// Three checks must all pass — key hash, appId, and origin/IP allow-list.
model PublicApiClient {
  id      String @id @default(cuid())
  appId   String @unique // caller identity sent in X-App-Id, e.g. "it-portal"
  name    String
  keyHash String @unique // SHA-256 of the raw key; the raw key is shown once, at creation

  // Allow-list is closed by default: a client with both lists empty is refused.
  allowedOrigins String[] // hostnames allowed in Origin/Referer
  allowedIps     String[] // exact IPs (v4/v6). No CIDR — see publicApi/auth.ts

  active     Boolean   @default(true)
  expiresAt  DateTime?
  lastUsedAt DateTime?

  createdById String
  createdBy   User     @relation("publicApiClientCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

// Cross-cutting audit trail for project-domain mutations (who did what, when).
// Written centrally from the Apollo plugin, not per-resolver.
model AuditLog {
  id       String   @id @default(cuid())
  action   String // the GraphQL mutation field name, e.g. createProject
  entityId String? // affected row id when known
  label    String? // human label (project/feature/testcase name or issue title)
  actor    String? // actor display name
  actorId  String?
  at       DateTime @default(now())

  @@index([at])
  @@index([actorId])
}
